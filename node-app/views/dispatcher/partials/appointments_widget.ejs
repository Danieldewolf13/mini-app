<section class="panel appointments-panel">
  <div class="section-head">
    <div>
      <p class="section-kicker"><%= t("dashboard.appointments.kicker", "Planning") %></p>
      <h2><%= t("dashboard.appointments.title", "Upcoming") %></h2>
    </div>
    <a class="section-link" href="/dispatcher/planning"><%= t("common.view_all", "View all") %></a>
  </div>

  <div class="appointment-list compact-list appointments-preview">
    <% const now = Date.now(); %>
    <% const previewAppointments = (typeof appointments_preview !== "undefined" && appointments_preview?.length) ? appointments_preview : appointments.slice(0, 4); %>
    <% if (previewAppointments.length) { %>
      <% previewAppointments.forEach((appt) => { %>
        <% const scheduledAtTs = new Date(appt.scheduled_at).getTime(); %>
        <% const isSoon = !Number.isNaN(scheduledAtTs) && scheduledAtTs <= now + (4 * 60 * 60 * 1000); %>
        <button class="appointment-card <%= isSoon ? 'soon' : 'planned' %> <%= !appt.technician_name ? 'needs-assignment' : '' %>" type="button" data-job-id="<%= appt.id %>">
          <strong><%= appt.scheduled_at_label %></strong>
          <p>#<%= appt.id %> - <%= appt.client_name || "-" %></p>
          <p class="muted"><%= appt.technician_name || "Unassigned" %> - <%= appt.afspraak_type_label || "-" %></p>
        </button>
      <% }) %>
    <% } else { %>
      <p class="empty-state">Geen activiteiten in de komende vier uur.</p>
    <% } %>
  </div>
</section>
