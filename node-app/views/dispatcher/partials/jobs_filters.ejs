<section class="panel filters-panel">
  <div class="filters">
    <input id="job-search" placeholder="Zoeken" />
    <select id="status-filter" name="status">
      <option value="">Alle statussen</option>
      <% filters.statuses.forEach((status) => { %>
        <option value="<%= status %>"><%= status %></option>
      <% }) %>
    </select>
    <select id="technician-filter" name="technician">
      <option value="">Alle techniekers</option>
      <% filters.technicians.forEach((tech) => { %>
        <option value="<%= tech.name %>"><%= tech.name %></option>
      <% }) %>
    </select>
    <select id="date-filter" name="date">
      <option value="">Alle datums</option>
      <option value="today">Vandaag</option>
      <option value="older">Ouder</option>
    </select>
  </div>
</section>
