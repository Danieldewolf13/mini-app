<%
const layout = dashboardLayout || currentPreferences.dashboard;
const modulePartials = {
  queue: "./partials/action_queue",
  jobs: "./partials/active_jobs_list",
  technicians: "./partials/technicians_widget",
  appointments: "./partials/appointments_widget",
};

const workspaceOrder = [layout.slots.left, layout.slots.center, layout.slots.sideTop, layout.slots.sideBottom].filter(
  (value, index, array) => array.indexOf(value) === index
);

function renderWorkspaceModule(moduleKey) {
  if (!layout.visible[moduleKey]) {
    return "";
  }

  return `<div class="workspace-zone workspace-zone-${moduleKey}">${include(modulePartials[moduleKey])}</div>`;
}

const body = `
<div class="dashboard-page dashboard-canvas">
  <section class="dashboard-row dashboard-row-kpis">
    ${include("./partials/dashboard_kpis")}
  </section>


  ${
    currentUser && currentUser.role !== "technician"
      ? `
        <section class="dashboard-row dashboard-row-suggested-actions">
          ${include("./partials/suggested_actions_widget")}
        </section>
      `
      : ``
  }

  ${
    workspaceOrder.some((moduleKey) => layout.visible[moduleKey])
      ? `
        <section class="dashboard-row dashboard-row-workspace dashboard-row-workspace-inline">
          ${workspaceOrder.map((moduleKey) => renderWorkspaceModule(moduleKey)).join("")}
        </section>
      `
      : ``
  }

  ${
    layout.visible.detail
      ? `
        <section class="dashboard-row dashboard-row-detail">
          <div class="detail-zone">
            ${include("./partials/job_detail_panel")}
          </div>
        </section>
      `
      : ``
  }

  ${
    layout.visible.map
      ? `
        <section class="panel map-card map-zone">
          <div class="section-head">
            <div>
              <p class="section-kicker">${t("dashboard.map.kicker", "Overview")}</p>
              <h2>${t("dashboard.map.title", "Mini map")}</h2>
            </div>
            <span class="section-meta">Regional overview only</span>
          </div>
          ${include("./partials/mini_map")}
        </section>
      `
      : ``
  }
</div>
`; %>
<%- include("../layout/base", { ...locals, body }) %>
