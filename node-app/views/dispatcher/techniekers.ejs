<%
const esc = (value) =>
  String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");

const rows = telegramUsers.map((u) => {
  const opts = techKeyOptions
    .map((k) => `<option value="${esc(k)}" ${String(u.tech_key || "") === k ? "selected" : ""}>${esc(k)}</option>`)
    .join("");

  return `
    <tr class="${u.is_active ? "" : "row--inactive"}">
      <td>
        <strong>${esc(u.full_name || "—")}</strong>
        ${u.tg_id ? `<div class="users-table-meta">tg_id: ${esc(u.tg_id)}</div>` : '<div class="users-table-meta">Handmatig toegevoegd</div>'}
      </td>
      <td>${esc(u.tech_key || "—")}</td>
      <td>
        <form method="post" action="/dispatcher/technicians/${esc(u.tg_id || "0")}/update" class="inline-form" style="display:flex;gap:6px;align-items:center">
          <select name="tech_key" class="sa-input">
            <option value="">— geen —</option>
            ${opts}
          </select>
          <select name="is_active" class="sa-input">
            <option value="1" ${u.is_active ? "selected" : ""}>Actief</option>
            <option value="0" ${!u.is_active ? "selected" : ""}>Inactief</option>
          </select>
          <button type="submit" class="inline-button">Opslaan</button>
        </form>
      </td>
    </tr>
  `;
}).join("");

const addOpts = techKeyOptions
  .map((k) => `<option value="${esc(k)}">${esc(k)}</option>`)
  .join("");

const body = `
  <div class="users-page">
    <section class="panel">
      <div class="section-head">
        <div>
          <p class="section-kicker">Beheer</p>
          <h2>Techniekers</h2>
        </div>
        <span class="section-meta">${telegramUsers.length} techniekers</span>
      </div>
      <p class="placeholder-copy">
        Alleen techniekers met een <strong>techniekercode</strong> en status <strong>Actief</strong> verschijnen in de planning, op de kaart en in job-toewijzing.
      </p>
      ${success ? `<div class="alert-banner alert-banner--success"><strong>Gelukt</strong><p>${success}</p></div>` : ""}
      ${locals.error ? `<div class="alert-banner"><strong>Fout</strong><p>${locals.error}</p></div>` : ""}
    </section>

    <section class="panel">
      <div class="section-head">
        <div>
          <p class="section-kicker">Nieuw</p>
          <h2>Technieker toevoegen</h2>
        </div>
      </div>
      <form method="post" action="/dispatcher/technicians/add" class="users-form">
        <label class="auth-field">
          <span>Volledige naam *</span>
          <input type="text" name="full_name" required placeholder="bv. Armadeos Janssen">
        </label>
        <label class="auth-field">
          <span>Techniekercode *</span>
          <select name="tech_key" required>
            <option value="">— kies code —</option>
            ${addOpts}
          </select>
        </label>
        <label class="auth-field">
          <span>Telegram ID (optioneel)</span>
          <input type="number" name="tg_id" placeholder="bv. 123456789 — laat leeg als onbekend">
        </label>
        <button class="auth-submit" type="submit">Toevoegen</button>
      </form>
    </section>

    <section class="panel">
      <div class="section-head">
        <div>
          <p class="section-kicker">Overzicht</p>
          <h2>Alle techniekers</h2>
        </div>
      </div>
      <table class="users-table">
        <thead>
          <tr>
            <th>Naam</th>
            <th>Code</th>
            <th>Code aanpassen · Status</th>
          </tr>
        </thead>
        <tbody>
          ${rows || '<tr><td colspan="3"><p class="empty-state">Nog geen techniekers gevonden. Voeg ze hierboven toe.</p></td></tr>'}
        </tbody>
      </table>
    </section>
  </div>
`;
%>
<%- include("../layout/base", { ...locals, body }) %>
