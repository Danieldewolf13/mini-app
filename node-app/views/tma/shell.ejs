<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= pageTitle %></title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: var(--tg-theme-bg-color, #fff);
      color: var(--tg-theme-text-color, #000);
      min-height: 100vh;
    }
    #tma-loading {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 80vh;
      flex-direction: column;
      gap: 16px;
      color: var(--tg-theme-hint-color, #888);
    }
    #tma-error {
      display: none;
      padding: 24px;
      text-align: center;
      color: var(--tg-theme-destructive-text-color, #f00);
    }
    #tma-frame {
      display: none;
      width: 100%;
      height: 100vh;
      border: none;
    }
    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid rgba(0,0,0,0.1);
      border-top-color: var(--tg-theme-button-color, #1a73e8);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <div id="tma-loading">
    <div class="spinner"></div>
    <p>Verbinden met Mini App...</p>
  </div>
  <div id="tma-error"></div>
  <iframe id="tma-frame" src="/dispatcher/dashboard" title="Dispatcher"></iframe>

  <script>
    const tg = window.Telegram?.WebApp;
    const loadingEl = document.getElementById("tma-loading");
    const errorEl = document.getElementById("tma-error");
    const frameEl = document.getElementById("tma-frame");

    function showError(msg) {
      loadingEl.style.display = "none";
      errorEl.style.display = "block";
      errorEl.textContent = msg;
    }

    function showApp() {
      loadingEl.style.display = "none";
      frameEl.style.display = "block";
    }

    async function authenticateViaTelegram(initData) {
      const resp = await fetch("/api/tma/auth", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ init_data: initData }),
      });
      return resp.ok;
    }

    async function init() {
      if (tg) {
        tg.ready();
        tg.expand();
      }

      // Already logged in
      <% if (currentUser) { %>
        showApp();
        return;
      <% } %>

      // Try Telegram initData auth
      const initData = tg?.initData;
      if (initData) {
        const ok = await authenticateViaTelegram(initData).catch(() => false);
        if (ok) {
          showApp();
          return;
        }
      }

      // No bot token or not from Telegram — redirect to login
      <% if (!botTokenConfigured) { %>
        showApp(); // show app without TMA auth (dev mode)
      <% } else { %>
        window.location.href = "/login?next=/tma";
      <% } %>
    }

    init().catch((err) => showError("Fout bij opstarten: " + err.message));
  </script>
</body>
</html>
